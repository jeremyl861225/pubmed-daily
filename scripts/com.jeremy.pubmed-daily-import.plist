<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<!-- 安裝步驟見 README。腳本本體放在 Application Support，不放桌面：
     桌面受隱私權保護，背景程式連讀取腳本檔本身都會被擋（exit 126）。 -->
<plist version="1.0">
<dict>
  <key>Label</key>
  <string>com.jeremy.pubmed-daily-import</string>

  <key>ProgramArguments</key>
  <array>
    <string>/bin/bash</string>
    <string>/Users/jeremy/Library/Application Support/pubmed-daily/import.sh</string>
  </array>

  <!-- cowork 資料夾一有變動就跑 -->
  <key>WatchPaths</key>
  <array>
    <string>/Users/jeremy/Desktop/claude cowork/PubMed 每日文獻</string>
  </array>

  <!-- 每小時補跑一次：關機期間累積的檔案、或推失敗的重試 -->
  <key>StartInterval</key>
  <integer>3600</integer>

  <key>RunAtLoad</key>
  <true/>

  <key>StandardErrorPath</key>
  <string>/Users/jeremy/Library/Application Support/pubmed-daily/err.log</string>
</dict>
</plist>
